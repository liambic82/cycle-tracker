{
  "name": "cycle-tracker",
  "version": "0.27.0",
  "private": true,
  "type": "module",
  "main": "index.ts",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "validate:estimates": "node --experimental-strip-types scripts/validate-period-estimates.ts",
    "research:predictions": "node --experimental-strip-types scripts/evaluate-period-policy.ts",
    "research:benchmark": "node --experimental-strip-types scripts/benchmark-period-dataset.mjs",
    "research:audit-zenodo": "node scripts/audit-zenodo-menstruation.mjs",
    "research:prepare-zenodo": "node --experimental-strip-types scripts/prepare-zenodo-menstruation.mjs",
    "research:compare-zenodo": "node --experimental-strip-types scripts/compare-zenodo-periods.mjs",
    "build:web": "expo export --platform web && node scripts/prepare-web.mjs",
    "build:all": "expo export --platform all && node scripts/prepare-web.mjs",
    "preview": "node scripts/serve-preview.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "tsc --noEmit && node scripts/build-privacy-pages.mjs --check && node --experimental-strip-types --test tests/*.test.ts",
    "privacy:generate": "node scripts/build-privacy-pages.mjs",
    "privacy:check": "node scripts/build-privacy-pages.mjs --check",
    "assets:brand": "node scripts/build-brand-assets.mjs",
    "check:ios-kdf": "node scripts/check-ios-kdf.mjs",
    "benchmark:journal": "node --experimental-strip-types scripts/benchmark-journal.mjs"
  },
  "dependencies": {
    "@noble/ciphers": "2.4.0",
    "@noble/hashes": "2.4.0",
    "@pdf-lib/fontkit": "1.1.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/slider": "5.2.0",
    "expo": "~57.0.27",
    "expo-asset": "~57.0.19",
    "expo-constants": "~57.0.21",
    "expo-crypto": "~57.0.3",
    "expo-document-picker": "~57.0.3",
    "expo-file-system": "~57.0.7",
    "expo-image-manipulator": "~57.0.21",
    "expo-notifications": "~57.0.22",
    "expo-screen-capture": "~57.0.4",
    "expo-secure-store": "~57.0.4",
    "expo-sharing": "~57.0.22",
    "expo-splash-screen": "~57.0.10",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "lucide-react-native": "^1.52.0",
    "pdf-lib": "1.17.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.3"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "prettier": "^3.9.9",
    "sharp": "0.34.5",
    "typescript": "~6.0.3"
  }
}
